# Spring Boot grading endpoint. Leave empty for an ungraded writing preview.
# The backend must accept/return the documented grade JSON contract.
VITE_GRADING_ENDPOINT=
# Spring Boot origin. The app adds /api/v1 to this address.
VITE_API_BASE_URL=
# Study APIs use the configured server by default. Set false for older servers.
VITE_API_STUDY=
# Development defaults to a local demo when both server endpoints are empty.
# Set true to enable the local demo in a preview build as well.
VITE_API_MOCK=
